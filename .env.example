# Copy to .env for a source checkout, or to dockers/.env for Docker Compose,
# then fill in. Never commit the result.
#
# The two locations are not interchangeable: a source run loads .env from the
# repository root and never looks in dockers/.

# --- Model provider (required) ---
ANTHROPIC_API_KEY=REPLACE_ME

# --- Login gate ---
# The app fails closed: with USE_LOGIN=true and either value blank, it refuses
# to render a login form at all rather than accepting an empty submission.
USE_LOGIN=true
USER_ID=REPLACE_ME
USER_PASSWORD=REPLACE_ME_WITH_A_STRONG_VALUE

# --- MCP tool registration ---
# Registering an MCP server launches a subprocess. Leave the in-app editor off
# unless you trust everyone who can reach the UI, and edit data/config.json
# directly instead.
MCP_ALLOW_TOOL_EDIT=false
# Comma-separated allowlist for MCP server `command` values.
# Default: npx,uvx,node,python,python3,docker
# MCP_ALLOWED_COMMANDS=npx,python3
# Where the server list is read from and written to, relative to the directory
# you launch Streamlit from. The Docker image points this at the mounted volume
# so tools added through the UI survive the container being recreated; you do
# not normally set it yourself.
# MCP_CONFIG_PATH=config.json

# --- Profiles and the shell capability ---
# A profile says which MCP servers to open, whether the agent may run commands,
# which commands stop for a person, and the ceilings on one run. With no file
# there is one profile: every configured server, no shell. See docs/PROFILES.md.
# MCP_PROFILES_PATH=profiles.json

# The operator's half of the shell switch. The profile sets the other half, and
# BOTH are required — a profile is a file someone may have been handed, and it
# must not be able to enable a capability this deployment did not.
MCP_ENABLE_SHELL=false

# Permits the host execution policy for profiles that ask for it. It does not
# impose it: profiles that asked for the sandbox still run in the sandbox.
# `host` runs the model's commands as the process serving the page, with this
# machine's network. Read docs/PROFILES.md before setting it.
# MCP_SHELL_POLICY=host

# The one directory a profile may mount into the sandbox. Unset means a profile
# gets a temporary directory whatever it asks for — `--read-only` does not
# cover bind mounts, so an unbounded profile could mount a home directory.
# MCP_WORKSPACE_ROOT=/srv/workspaces

# The container commands run in. Debian-based on purpose: they run through
# /bin/bash, which Alpine does not ship.
# MCP_SANDBOX_IMAGE=python:3.12-slim

# --- Optional: LangSmith tracing ---
# Off by default. Enabling it sends every prompt, tool result and model
# response to a third-party service. Consumed by the LangSmith SDK, not by
# this application's code.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=REPLACE_ME
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=LangGraph-MCP-Agents

# --- Tool execution ---
# How long one MCP tool call may run before it is cut short and reported to
# the model as a failed tool result. Keep it comfortably below the turn
# timeout in the sidebar: if the turn deadline lands while a tool is still
# running, the conversation is left with a tool call that has no result, and
# every later turn on that thread is rejected. The sidebar's own range is
# 60-600 seconds, default 120, so leaving this at its default while dragging
# that slider to its minimum puts the two exactly level — the app warns when
# they conflict.
#
# In SECONDS. The name is generic enough to collide with an unrelated MCP
# client's millisecond setting of the same name, and 60000 is accepted in
# silence as a 16-hour bound.
# MCP_TOOL_TIMEOUT=60

# --- Conversation persistence ---
# Conversations are stored in SQLite so they survive a restart. The path is
# relative to the working directory; under Docker it lands on the mounted
# volume alongside config.json. Set to :memory: for the old behaviour, where
# every restart loses every conversation.
# CHECKPOINT_DB_PATH=data/checkpoints.db

# --- Prompt caching ---
# Lifetime of the cached prompt prefix: "5m" or "1h". 1h is the default because
# a chat window routinely leaves more than five minutes between turns, and an
# expired prefix is rewritten at 1.25x rather than read at 0.1x. The longer TTL
# costs 2.0x on the writes themselves. Any other value logs a warning and falls
# back to 1h.
# PROMPT_CACHE_TTL=1h

# --- Logging ---
LOG_LEVEL=INFO
