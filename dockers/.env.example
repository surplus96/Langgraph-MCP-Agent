# Copy to dockers/.env and fill in. Never commit the result.

# --- Model provider (required) ---
ANTHROPIC_API_KEY=REPLACE_ME

# --- Login gate ---
# The app fails closed: with USE_LOGIN=true and either value blank, it refuses
# to render a login form at all rather than accepting an empty submission.
USE_LOGIN=true
USER_ID=REPLACE_ME
USER_PASSWORD=REPLACE_ME_WITH_A_STRONG_VALUE

# --- MCP tool registration ---
# Registering an MCP server launches a subprocess. Leave the in-app editor off
# unless you trust everyone who can reach the UI, and edit data/config.json
# directly instead.
MCP_ALLOW_TOOL_EDIT=false
# Comma-separated allowlist for MCP server `command` values.
# Default: npx,uvx,node,python,python3,docker
# MCP_ALLOWED_COMMANDS=npx,python3

# --- Profiles and the shell capability ---
# A profile says which MCP servers to open, whether the agent may run commands,
# which commands stop for a person, and the ceilings on one run. With no file
# there is one profile: every configured server, no shell. See docs/PROFILES.md.
# MCP_PROFILES_PATH=/app/data/profiles.json   # on the mounted volume

# The operator's half of the shell switch. The profile sets the other half, and
# BOTH are required — a profile is a file someone may have been handed, and it
# must not be able to enable a capability this deployment did not.
MCP_ENABLE_SHELL=false

# Permits the host execution policy for profiles that ask for it. It does not
# impose it: profiles that asked for the sandbox still run in the sandbox.
# `host` runs the model's commands as the process serving the page, with this
# machine's network. Read docs/PROFILES.md first — and note this container has no Docker
# socket, so the sandbox is not reachable from inside it.
# MCP_SHELL_POLICY=host

# The one directory a profile may mount into the sandbox. A profile's own
# `workspace_root` is honoured only if it is inside this one; anything else is
# refused with a warning, and so is everything if this is unset — `--read-only`
# does not cover bind mounts, so an unbounded profile could mount a home
# directory. Refused means no mount at all: under the docker policy the
# container then runs with `-w /` on a read-only root, so commands can read the
# image and write nowhere. `example_profiles.json` asks for
# /srv/workspaces/project, which is inside the value below.
# MCP_WORKSPACE_ROOT=/srv/workspaces

# The container commands run in. Debian-based on purpose: they run through
# /bin/bash, which Alpine does not ship.
# MCP_SANDBOX_IMAGE=python:3.12-slim

# Passed through to MCP servers launched with `npx`; this application does not
# read it. The arm64 overlay (docker-compose.arm64.yaml) already sets
# --max_old_space_size=2048, which is the limit an npx server hits first on
# Apple Silicon. Set it here only to override that.
# NODE_OPTIONS=--max_old_space_size=2048

# --- Optional: LangSmith tracing ---
# Off by default. Enabling it sends every prompt, tool result and model
# response to a third-party service. Consumed by the LangSmith SDK, not by
# this application's code.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=REPLACE_ME
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=LangGraph-MCP-Agents

# --- Tool execution ---
# How long one MCP tool call may run, IN SECONDS, before it is cut short and
# reported to the model as a failed tool result. Keep it below the turn limit
# in the sidebar (60-600s, default 120): a turn deadline that lands while a
# tool is still running leaves the conversation with a tool call that has no
# result, and every later turn on that thread is rejected. The app warns when
# the two conflict.
# MCP_TOOL_TIMEOUT=60

# --- Conversation persistence ---
# Conversations are stored in SQLite so they survive a restart. Under Compose
# this lands on the mounted volume alongside config.json. Set to :memory: for
# the old behaviour, where every restart loses every conversation.
# CHECKPOINT_DB_PATH=/app/data/checkpoints.db

# Where the MCP server list is read from and written to. The image already
# points this at the mounted volume; override it only to move that file.
# MCP_CONFIG_PATH=/app/data/config.json

# --- Prompt caching ---
# Lifetime of the cached prompt prefix: "5m" or "1h". Any other value logs a
# warning and falls back to 1h. See .env.example in the repository root for
# why 1h is the default.
# PROMPT_CACHE_TTL=1h

# --- Logging ---
LOG_LEVEL=INFO
