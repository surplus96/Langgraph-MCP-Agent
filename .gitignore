# Virtual environments
.venv

# Environment variables
.env

# Runtime MCP server configuration. Holds credentials for the servers it
# launches; ship example_config.json instead.
config.json

# Runtime profiles. Names directories and servers particular to one deployment,
# and decides what the agent may run there; ship example_profiles.json instead.
profiles.json

